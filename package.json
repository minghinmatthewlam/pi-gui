{
  "name": "pi-gui",
  "private": true,
  "version": "0.1.0-beta.33",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @pi-gui/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm check:workspaces && pnpm build:shared && pnpm -r --if-present typecheck",
    "package:win": "pnpm --filter @pi-gui/desktop run package:win",
    "package:win:dir": "pnpm --filter @pi-gui/desktop run package:win:dir",
    "lint": "pnpm build:shared && eslint . --max-warnings 0",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "test:homebrew-tap": "node scripts/test-update-homebrew-tap.mjs",
    "test:release-helpers": "node --test apps/desktop/scripts/release-artifacts.test.mjs apps/desktop/scripts/github-release-state.test.mjs apps/desktop/scripts/verify-linux-release.test.mjs scripts/verify-release-version.test.mjs",
    "verify:install-copy": "node scripts/verify-install-copy.mjs",
    "verify:release-config": "node apps/desktop/scripts/verify-release-config.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "verify:homebrew-flow": "node scripts/verify-homebrew-flow.mjs",
    "release:homebrew-sync": "node scripts/release-homebrew-sync.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm check:architecture && pnpm typecheck && pnpm test:baseline",
    "test:guards": "node --test scripts/ci-guards.test.mjs scripts/check-renderer-boundary.test.mjs scripts/check-workspace-typechecks.test.mjs scripts/format-guard.test.mjs scripts/check-ci-results.test.mjs scripts/typed-lint.test.mjs",
    "test:baseline": "pnpm test:guards && pnpm --filter @pi-gui/pi-sdk-driver test && pnpm test:release-helpers && pnpm test:desktop-unit",
    "check:architecture": "node scripts/check-renderer-boundary.mjs",
    "check:workspaces": "node scripts/check-workspace-typechecks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:desktop-unit": "playwright test -c apps/desktop/playwright.config.ts apps/desktop/tests/unit",
    "build:shared": "pnpm --filter @pi-gui/session-driver build && pnpm --filter @pi-gui/catalogs build && pnpm --filter @pi-gui/pi-sdk-driver build"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "pnpm": "10.25.0",
    "prettier": "3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "yaml": "2.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "video"
  ]
}
