{
  "name": "@pi-gui/catalogs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./node/atomic-write": {
      "types": "./dist/node/atomic-write.d.ts",
      "default": "./dist/node/atomic-write.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/**/*.test.mts\""
  },
  "dependencies": {
    "@pi-gui/session-driver": "workspace:*"
  }
}
