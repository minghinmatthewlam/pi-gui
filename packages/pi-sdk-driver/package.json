{
  "name": "@pi-gui/pi-sdk-driver",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "SDK-first session driver spike for pi-gui.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-provider-types": {
      "types": "./dist/custom-provider-types.d.ts",
      "default": "./dist/custom-provider-types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/**/*.test.mts\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@pi-gui/catalogs": "workspace:*",
    "@pi-gui/extension-ui": "workspace:*",
    "@pi-gui/session-driver": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1"
  }
}
